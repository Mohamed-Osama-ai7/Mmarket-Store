# Copy this file to .env and replace the JWT secret before running the backend.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/mean-l2?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1d
ALLOWED_ORIGINS=http://localhost:4200
DUMMY_PASSWORD_HASH=$2b$12$HrcL.PN5mx6kmCl22zS71eodMVI2A3iYLafBfkmFC0rBgFIgs/fgy
PAYMENT_PROVIDER=manual

# Password reset and transactional email (Resend). Configure in production.
APP_URL=http://localhost:4200
RESEND_API_KEY=
MAIL_FROM=
RESET_EMAIL_MODE=console
PUBLIC_SITE_URL=http://localhost:4200

# Simple local defaults; Docker Compose selects MongoDB-backed shared stores.
CACHE_STORE=memory
SHARED_RATE_LIMIT_STORE=memory
PRODUCT_LIST_CACHE_TTL_SECONDS=60
TRUST_PROXY=false

# Optional AI product-to-model preview. Keep this key server-side; never expose it in Angular.
FASHN_API_KEY=
