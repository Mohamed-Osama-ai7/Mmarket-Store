# Copy to .env for Docker Compose. Generate a unique secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1d
DUMMY_PASSWORD_HASH='$2b$12$HrcL.PN5mx6kmCl22zS71eodMVI2A3iYLafBfkmFC0rBgFIgs/fgy'
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
PUBLIC_SITE_URL=http://localhost:8080
APP_URL=http://localhost:8080
# Optional production email delivery (Resend)
RESEND_API_KEY=
MAIL_FROM=
RESET_EMAIL_MODE=console

# Optional virtual try-on provider key; server-side only. Never put this in Angular env files.
FASHN_API_KEY=
